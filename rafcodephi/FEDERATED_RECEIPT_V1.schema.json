{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:rafcodephi:federated-receipt:v1",
  "title": "RAFCODE-Φ federated evidence receipt (public-safe envelope)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "mu_id",
    "observed_at",
    "source",
    "artifact",
    "authority",
    "execution",
    "evidence",
    "claim",
    "gaps",
    "next",
    "rollback"
  ],
  "properties": {
    "schema_version": {
      "const": "rafcodephi.federated_receipt.v1"
    },
    "mu_id": {
      "type": "string",
      "minLength": 8,
      "maxLength": 160
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "parent": {
      "$ref": "#/$defs/known_or_unknown"
    },
    "source": {
      "$ref": "#/$defs/locator"
    },
    "artifact": {
      "$ref": "#/$defs/locator"
    },
    "authority": {
      "$ref": "#/$defs/locator"
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "ref"
      ],
      "properties": {
        "status": {
          "enum": [
            "NOT_RUN",
            "IMPLEMENTED_UNTESTED",
            "PASS",
            "FAIL",
            "BLOCKED"
          ]
        },
        "ref": {
          "$ref": "#/$defs/locator"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "PASS"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "ref": {
                "$ref": "#/$defs/verified_locator"
              }
            }
          }
        }
      ]
    },
    "evidence": {
      "$ref": "#/$defs/locator"
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allowed",
        "scope"
      ],
      "properties": {
        "allowed": {
          "type": "boolean"
        },
        "scope": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "gaps": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "reason"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "next": {
      "type": "string",
      "minLength": 1
    },
    "rollback": {
      "type": "string",
      "minLength": 1
    },
    "relations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "target"
        ],
        "properties": {
          "type": {
            "enum": [
              "derived_from",
              "observed_in",
              "validated_by",
              "supersedes",
              "blocked_by",
              "indexes"
            ]
          },
          "target": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  },
  "$defs": {
    "known_or_unknown": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "$ref": "#/$defs/unknown"
        }
      ]
    },
    "unknown": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "reason"
      ],
      "properties": {
        "state": {
          "const": "TOKEN_VAZIO"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "verified_locator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "provider",
        "ref",
        "visibility"
      ],
      "properties": {
        "state": {
          "const": "VERIFIED"
        },
        "provider": {
          "enum": [
            "github",
            "google_drive",
            "supabase",
            "alphaxiv",
            "external"
          ]
        },
        "ref": {
          "type": "string",
          "minLength": 1
        },
        "visibility": {
          "enum": [
            "public",
            "private",
            "restricted",
            "TOKEN_VAZIO"
          ]
        },
        "immutable_digest": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "locator": {
      "oneOf": [
        {
          "$ref": "#/$defs/verified_locator"
        },
        {
          "$ref": "#/$defs/unknown"
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "claim": {
            "properties": {
              "allowed": {
                "const": true
              }
            },
            "required": [
              "allowed"
            ]
          }
        },
        "required": [
          "claim"
        ]
      },
      "then": {
        "properties": {
          "execution": {
            "properties": {
              "status": {
                "const": "PASS"
              },
              "ref": {
                "$ref": "#/$defs/verified_locator"
              }
            }
          },
          "evidence": {
            "$ref": "#/$defs/verified_locator"
          },
          "authority": {
            "$ref": "#/$defs/verified_locator"
          }
        }
      }
    }
  ]
}
